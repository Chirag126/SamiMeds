# Copy to .env for local runs (never commit real secrets).
PORT=8080

# memory (local) or firestore (default on Cloud Run)
STORE=memory
# Keep local data between restarts (memory store only)
DATA_FILE=./data.json

# Creates the demo circle "DEMO" (PINs: elder 2580, family 1357, caretaker 2468)
DEMO_MODE=true
DEFAULT_TIMEZONE=Asia/Kolkata
PUBLIC_URL=http://localhost:8080

# Cloud Scheduler sends this in the X-Cron-Secret header to POST /api/cron/tick
CRON_SECRET=change-me
# Run reminders in-process every minute (on locally, off on Cloud Run)
INTERNAL_SCHEDULER=true

# Gemini (optional) – "describe the medicine" quick add
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cloud Storage bucket for pill photos (optional – otherwise stored in the database)
PHOTO_BUCKET=

# Email (optional – e.g. Gmail SMTP with an app password). Without it, reminders show in the Alerts tab.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SamiMeds <your-address@gmail.com>
