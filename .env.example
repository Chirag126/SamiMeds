# SamiMeds configuration template.
#
# HOW TO USE
#   1. Copy this file to ".env"         (cp .env.example .env)
#   2. Fill in your own values in .env  (never in this file)
#   3. Run: node --env-file=.env src/server.js
#
# .env is ignored by git, so your keys stay on your computer.
# On Render, add the same names under Dashboard → your service → Environment.
# KEEP THIS FILE WITHOUT REAL VALUES – it is committed to GitHub.

PORT=8080

# memory (local) or firestore
STORE=memory
# Keep local data between restarts (memory store only)
DATA_FILE=./data.json

# Creates the demo circle "DEMO" (PINs: elder 2580, family 1357, caretaker 2468)
DEMO_MODE=true
DEFAULT_TIMEZONE=Asia/Kolkata
# Contact details shown for the demo people (Kamla, Chirag, Anjali). Optional.
DEMO_ELDER_EMAIL=
DEMO_FAMILY_EMAIL=
DEMO_FAMILY_PHONE=
DEMO_CARETAKER_EMAIL=
DEMO_CARETAKER_PHONE=
# Your site address, e.g. https://samimeds.onrender.com (used for links in emails)
PUBLIC_URL=

# Any long random text you make up. Protects POST /api/cron/tick.
CRON_SECRET=
# Run reminders inside the app every minute
INTERNAL_SCHEDULER=true

# Gemini – get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cloud Storage bucket for pill photos (optional)
PHOTO_BUCKET=

# Gmail – create an app password at https://myaccount.google.com/apppasswords
# (needs 2-Step Verification). Use the 16-character app password, not your Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Firestore outside Google Cloud (e.g. Render): path to a service-account key file.
# On Render, upload it as a Secret File and use /etc/secrets/<filename>.
GOOGLE_APPLICATION_CREDENTIALS=
