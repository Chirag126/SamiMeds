{
  "name": "samimeds",
  "version": "1.0.0",
  "description": "SamiMeds \u2013 a warm, simple medication & care platform for elderly people, their family and caretakers.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "DEMO_MODE=true node --watch src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "seed": "DEMO_MODE=true node src/seed-cli.js",
    "check:secrets": "node scripts/check-secrets.mjs --all",
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "eslint .",
    "push:keys": "node scripts/push-keys.mjs",
    "check": "npm run lint && npm test && npm run check:secrets"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "@google-cloud/storage": "^7.15.0",
    "nodemailer": "^6.9.16",
    "web-push": "^3.6.7"
  },
  "license": "MIT",
  "devDependencies": {
    "eslint": "^9.15.0",
    "@eslint/js": "^9.15.0",
    "globals": "^15.12.0"
  }
}
